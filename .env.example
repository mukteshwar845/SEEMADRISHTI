# =============================================================================
# SEEMADRISHTI AI - Environment Configuration Template
# Copy this file to .env and configure your secure values.
# NEVER commit your actual .env file to version control.
# =============================================================================

# Server Port
PORT=8000

# Machine-to-Machine Secret Key (for cv_service -> backend API authentication)
# Generate with: openssl rand -hex 32
API_KEY=

# WebSocket Ingestion Token (for cv_service telemetry publishing)
# Generate with: openssl rand -hex 32
CV_SERVICE_TOKEN=

# Operator JWT Authentication Secret
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Database Path
DATABASE_PATH=data/seemadrishti.sqlite

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# Gemini API Key (Required for AI Agents and Help Bot)
GEMINI_API_KEY=
